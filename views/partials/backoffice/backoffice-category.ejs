<div class="col-md-9 col-lg-10">
  <div class="content">
    <div class="search-container">
      <div class="input-group">
        <input
          type="text"
          class="form-control search-input"
          placeholder="Search..."
        />
        <div class="input-group-append">
          <button class="btn search-button" type="button">
            <i class="bi bi-search-heart-fill"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th class="checkbox-cell"><input type="checkbox" /></th>
            <th>Image</th>
            <th>Category Name</th>
            <th class="action-cell">
              <button style="border-radius: 5px; border-color: black">
                <i class="bi bi-sort-alpha-down"></i>
              </button>
            </th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(category => { %>
          <tr>
            <td class="checkbox-cell"><input type="checkbox" /></td>
            <td>
              <img
                class="tableImage"
                src="<%= category.image_path %>"
                alt="<%= category.category_name %>"
              />
            </td>
            <td><%= category.category_name %></td>
            <td class="action-cell">
              <div class="dropdown">
                <button
                  class="btn dropdown-toggle no-caret-dropdown"
                  type="button"
                  data-toggle="dropdown"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="dropdown-menu">
                  <a
                    class="dropdown-item"
                    href="/backoffice/category/edit/<%= category.category_id %>"
                  >
                    <i class="bi bi-pencil-fill mr-2"></i> Edit</a
                  >
                  <a
                    class="dropdown-item delete-category"
                    href="#"
                    data-id="<%= category.category_id %>"
                  >
                    <i class="bi bi-trash-fill mr-2"></i>
                    Delete</a
                  >
                </div>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
  $(document).ready(function () {
    $(".delete-category").on("click", function(e) {
      e.preventDefault();
      const categoryId = $(this).data("id");

      if (confirm("Are you sure you want to delete this category?")) {
        $.ajax({
          url: `/backoffice/category/delete/${categoryId}`,
          method: "DELETE",
          success: function(response) {
            alert(response.message);
            window.location.href = "/backoffice/category";
          },
          error: function(xhr) {
            alert(xhr.responseJSON.error);
          }
        });
      }
    });
  });
</script>