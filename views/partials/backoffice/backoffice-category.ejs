<div class="col-md-9 col-lg-10">
  <div class="content">
    <div class="search-container">
      <div class="input-group">
        <input type="text" class="form-control search-input" placeholder="Search...">
        <div class="input-group-append">
          <button class="btn search-button" type="button">
            <i class="bi bi-search-heart-fill"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th class="checkbox-cell"><input type="checkbox"></th>
            <th>Category_Name</th>
            <th class="action-cell"><button style="border-radius: 5px; border-color:black ;"><i
                  class="bi bi-sort-alpha-down"></button></i></th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(category=> { %>
            <tr>
              <th class="checkbox-cell"><input type="checkbox"></th>
              <th>Image</th>
              <th>Category Name</th>
              <th class="action-cell"><button style="border-radius: 5px; border-color:black ;"><i class="bi bi-sort-alpha-down"></button></i></th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach(category => { %>
              <tr>
                <td class="checkbox-cell"><input type="checkbox"></td>
                <td><img class="tableImage" src="<%= category.image_path %>" alt="<%= category.category_name %>"></td>
                <td><%= category.category_name %></td>
                <td class="action-cell">
                <div class="dropdown">
                  <button class="btn dropdown-toggle no-caret-dropdown" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <div class="dropdown-menu">
                    <a class="dropdown-item" href="#">Edit</a>
                    <a class="dropdown-item" href="#">Delete</a>
                  </div>
                </div>
                </td>
              </tr>
            <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>