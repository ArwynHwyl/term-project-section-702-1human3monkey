<div class="col-md-9 col-lg-10">
  <div class="content">
    <div class="search-container">
      <div class="input-group">
        <input
          type="text"
          class="form-control search-input"
          placeholder="Search..."
        />
        <div class="input-group-append">
          <button class="btn search-button" type="button">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Description</th>
            <th>Category</th>
            <th>Normal Price</th>
            <th>Discount Percent</th>
            <th class="action-cell"></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
          <tr>
            <td data-cell="Image">
              <img
                src="/public/<%= product.image_path %>"
                alt="<%= product.product_name %>"
                class="img-thumbnail"
                style="width: 100px"
              />
            </td>
            <td data-cell="Products Name"><%= product.product_name %></td>
            <td data-cell="Description"><%= product.description %></td>
            <td data-cell="Category"><%= product.category_name %></td>
            <td data-cell="Price"><%= product.normal_price %></td>
            <td data-cell="Discount"><%= product.promotion_percent %></td>
            <td data-cell="Action">
              <a
                href="/backoffice/product/edit/<%= product.product_id %>"
                class="btn btn-warning btn-sm"
                >Edit</a
              >
              <button
                class="btn btn-danger btn-sm delete-product"
                data-id="<%= product.product_id %>"
              >
                Delete
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
