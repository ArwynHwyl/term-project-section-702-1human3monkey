<div class="col-md-9 col-lg-10">
  <div class="content">
    <div class="search-container">
      <div class="input-group">
        <input type="text" class="form-control search-input" placeholder="Search...">
        <div class="input-group-append">
          <button class="btn search-button" type="button">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Product Name</th>
            <th>Product Description</th>
            <th>Category</th>
            <th>Normal Price</th>
            <th>Discount Percent</th>
            <th class="stock-cell">Stock</th>
            <th class="action-cell"></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product, index) => { %>
            <tr>
              <td><img src="<%= product.image || 'https://via.placeholder.com/50' %>" alt="Product Image" class="product-image"></td>
              <td><%= product.productname %></td>
              <td><%= product.description %></td>
              <td><%= product.category %></td>
              <td><%= product.normalPrice %></td>
              <td><%= product.discountPercent %></td>
              <td class="stock-cell"><%= product.stock %></td>
              <td class="action-cell">
                <a href="/backoffice/product/edit/<%= index %>">
                  <i class="bi bi-pencil edit-icon"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>