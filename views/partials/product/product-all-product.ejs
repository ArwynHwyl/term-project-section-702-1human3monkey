<div class="products-section">
    <h2 class="section-title">ALL PRODUCT</h2>
  
    <div class="products-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach((product, index) => { %>
          <div class="product-item card">
            <a href="/product/<%= encodeURIComponent(product.product_name.replace(/\s+/g, '-')) %>/<%= product.product_id %>">

              <img class="card-img-top" src="<%= product.image_path || '/public/images/placeholder.jpg' %>" alt="<%= product.product_name %>">

              <div class="product-info card-body">
                <h5 class="card-title"><%= product.product_name %></h5>
                <div class="product-price card-text">
                  <% if (product.discount_percent > 0) { %>
                    <span class="original-price">฿<%= parseFloat(product.normal_price).toLocaleString() %></span>
                    <span class="discount-price">฿<%= (parseFloat(product.normal_price) * (1 - parseFloat(product.discount_percent)/100)).toLocaleString() %></span>
                  <% } else { %>
                    ฿<%= parseFloat(product.normal_price).toLocaleString() %>
                  <% } %>
                </div>
              </div>
            </a>
          </div>
        <% }); %>
      <% } else { %>
        <div class="no-products">
          <p>No products found</p>
        </div>
      <% } %>
    </div>
  
    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="pagination">
        <% if (pagination.currentPage > 1) { %>
          <a href="?page=1" class="page-btn">First</a>
        <% } %>
        
        <% 
          let startPage = Math.max(1, pagination.currentPage - 2);
          let endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
          
          // Always show at least 5 pages if available
          if (endPage - startPage < 4 && pagination.totalPages > 4) {
            if (startPage === 1) {
              endPage = Math.min(pagination.totalPages, 5);
            } else if (endPage === pagination.totalPages) {
              startPage = Math.max(1, pagination.totalPages - 4);
            }
          }
        %>
        
        <% for (let i = startPage; i <= endPage; i++) { %>
          <a href="?page=<%= i %>" class="page-btn <%= i === pagination.currentPage ? 'active' : '' %>"><%= i %></a>
        <% } %>
        
        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a href="?page=<%= pagination.totalPages %>" class="page-btn">Last</a>
        <% } %>
      </div>
    <% } %>
  </div>