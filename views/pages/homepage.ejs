
<body>
  <link rel="stylesheet" href="/public/css/homepagestyles.css">
  <%- include('../partials/header') %>
  <%- include('../partials/navbarFrontPage') %>
  <div class="container">
    <div class="main-content">
      <section class="highlight mb-4" >
        <h2 class="h4 border-bottom pb-2" style="padding-left: 10px;">HIGHLIGHT</h2>
        <div id="carouselHighlight" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
          <div class="carousel-inner">
            <% if (data.carouselImages && data.carouselImages.length > 0) { %>
              <% data.carouselImages.forEach((img, index) => { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <a href="/category/<%= index %>">
                    <img src="/public/images/highlightbadge.jpg" class="d-block w-100" alt="Category Badge" style="height: 200px; object-fit: cover;">
                  </a>
                </div>
              <% }) %>
            <% } else { %>
              <div class="carousel-item active">
                <img src="https://via.placeholder.com/200x300" class="d-block w-100" alt="No Image" style="height: 200px; object-fit: cover;">
              </div>
            <% } %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselHighlight" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselHighlight" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </section>

      <section class="discounted-products mb-4">
        <h2 class="h4 border-bottom pb-2">SHOP THE DISCOUNTED PRODUCTS</h2>
        <div id="productCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="7000">
          <div class="carousel-inner">
            <% if (data.discountedProducts && data.discountedProducts.length > 0) { %>
              <% let chunkSize = 4; %>
              <% for (let i = 0; i < Math.ceil(data.discountedProducts.length / chunkSize); i++) { %>
                <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                  <div class="row row-cols-1 row-cols-md-4 g-3">
                    <% for (let j = i * chunkSize; j < (i + 1) * chunkSize && j < data.discountedProducts.length; j++) { %>
                      <div class="col">
                        <div class="product-card card h-100">
                          <img src="<%= data.discountedProducts[j].image_path || 'https://picsum.photos/200/300' %>" class="card-img-top" alt="<%= data.discountedProducts[j].product_name || 'Product' %>" style="height: 150px; object-fit: cover; transition: opacity 0.5s;">
                          <div class="card-body text-center">
                            <h4 class="card-title"><%= data.discountedProducts[j].product_name || 'Unnamed Product' %></h4>
                            <p class="card-text">
                              <s><%= Number(data.discountedProducts[j].normal_price || 0).toFixed(2) %> THB</s>
                              <% let discountedPrice = Number(data.discountedProducts[j].normal_price || 0) * (1 - Number(data.discountedProducts[j].discount_percent || 0)); %>
                              <%= discountedPrice.toFixed(2) %> THB
                            </p>
                          </div>
                        </div>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% } %>
            <% } else { %>
              <p>No discounted products available. Debug: <%= JSON.stringify(data) %></p>
            <% } %>
          </div>
          <% if (data.discountedProducts && data.discountedProducts.length > 4) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          <% } %>
        </div>
      </section>
    </div>
    <aside class="sidebar">
      <div class="card mb-3">
        <div class="card-body text-center">
          <h3 class="card-title">ALL PRODUCT</h3>
          <img src="/public/images/allproduct.jpg" class="card-img-top mb-2" alt="All Products" style="width: 100%; height: 100%;">
          <a href="/products" class="btn btn-danger">View</a>
        </div>
      </div>
      <div class="card">
        <div class="card-body text-center">
          <h3 class="card-title">ALL CATEGORY</h3>
          <img src="/public/images/allcategory.png" class="card-img-top mb-2" alt="All Categories" style="width: 100%; height: 100%;">
          <a href="/categories" class="btn btn-danger">View</a>
        </div>
      </div>
    </aside>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
</body>
</html>