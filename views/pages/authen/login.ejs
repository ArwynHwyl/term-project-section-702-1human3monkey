<%- include("../../partials/header.ejs") %>

    <div id="login" class="d-flex flex-column justify-content-center align-items-center vh-100">

        <div id="login-bg"
            class="container-fluid login z-0 opacity-25 position-absolute top-0 start-0 background-image"></div>

        <h1 class="title z-1">DAZZLE</h1>

        <div class="row w-100 d-flex justify-content-center align-items-center">
            <div class="z-1 opacity-100 bg-light p-5 shadow border-1 border border-secondary col-12 col-md-8 col-lg-6">
                <form action="/authen/login" method="post">
                    <h1 class="text-center fs-3">
                        <%= pageTitle %>
                    </h1>

                    <label for="username" class="mb-3 fw-semibold">Username</label>
                    <input id="username" type="text" class="form-control mb-3" placeholder="Enter your username">

                    <label for="password" class="mb-3 fw-semibold">Password</label>
                    <input id="password" type="password" class="form-control mb-3" placeholder="Enter your password">
                    <button class="btn w-100 mt-4">Login</button>
                    <p class="mt-5 text-body-tertiary text-center">Don't have an account? <a href="/auth/register" class="text-dark fw-semibold">Register</a></p>
                </form>
            </div>
        </div>
    </div>

    <%- include("../../partials/footer.ejs") %>