<%- include("../../partials/header.ejs") %>

    <div id="login" class="d-flex flex-column justify-content-center align-items-center vh-100">

        <div id="login-bg"
            class="container-fluid login z-0 opacity-25 position-absolute top-0 start-0 background-image"></div>

        <h1 class="title z-1">DAZZLE</h1>

        <div class="row w-100 d-flex justify-content-center align-items-center">
            <div class="z-1 opacity-100 bg-light p-5 shadow border-1 border border-secondary col-12 col-md-8 col-lg-6">
                <form action="/authen/register" method="post">
                    <h1 class="text-center fs-3">
                        <%= pageTitle %>
                    </h1>

                    <label for="full-name" class="mb-3 fw-semibold">Name</label>
                    <input id="full-name" name="name" type="text" class="form-control mb-3"
                        placeholder="Enter your name" required>

                    <label for="email" class="mb-3 fw-semibold">Email</label>
                    <input id="email" type="email" class="form-control mb-3" placeholder="Enter your email" required>

                    <label for="username" class="mb-3 fw-semibold">Username</label>
                    <input id="username" type="text" class="form-control mb-3" placeholder="Enter your username"
                        required>

                    <label for="password" class="mb-3 fw-semibold">Password</label>
                    <input id="password" type="password" class="form-control mb-3" placeholder="Create a password"
                        required>
                    <button type="submit" class="btn w-100 mt-4">Register</button>
                    <p class="mt-5 text-body-tertiary text-center">Already have an account? <a href="/auth/login" class="text-dark fw-semibold">Log in</a></p>
                </form>
            </div>
        </div>
    </div>

    <%- include("../../partials/footer.ejs") %>